# Server-only secrets. Configure these in Vercel Project Settings > Environment Variables.
# Never prefix them with VITE_ and never commit real secret values.
DEEPSEEK_API_KEY=
BSD_FOOTBALL_KEY=
# Legacy/fallback sports provider. BSD is preferred when BSD_FOOTBALL_KEY is configured.
API_FOOTBALL_KEY=

# Phase 3A sports-data cache. Backend only. Use a Supabase secret key (sb_secret_...).
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Phase 3B browser Auth/persistence. These two values are public by design.
# Use the same project URL plus a Supabase publishable key (sb_publishable_...).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
